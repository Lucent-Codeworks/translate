{
  "name": "@lucent-translate/nuxt",
  "version": "0.0.0",
  "description": "Nuxt module for Lucent Translate",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucent-translate/sdk": "workspace:^",
    "@lucent-translate/vue": "workspace:^",
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
