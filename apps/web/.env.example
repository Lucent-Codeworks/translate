DATABASE_URL=postgres://translate:translate@localhost:5437/translate

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The first account to sign up always becomes the instance admin.
# After that, public sign-up is disabled unless this is "true";
# admins create further users from the admin panel.
ALLOW_PUBLIC_SIGNUP=false
